{
  "name": "message-center-frontend",
  "version": "0.11.1b1",
  "private": true,
  "description": "The Message Center page for the Home Assistant sidebar",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "esbuild src/panel.ts --bundle --format=esm --target=es2022 --minify --legal-comments=none --outfile=../custom_components/message_center/frontend/message-center-panel.js && esbuild src/sidebar-icon.ts --bundle --format=esm --target=es2022 --minify --legal-comments=none --outfile=../custom_components/message_center/frontend/message-center-icons.js",
    "check": "tsc --noEmit",
    "preview": "esbuild src/preview.ts --bundle --format=esm --target=es2022 --outfile=preview/preview.js",
    "test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --target=node20 --outdir=.test-build --out-extension:.js=.mjs --log-level=warning && node --test .test-build/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "lit": "^3.3.0",
    "typescript": "^5.9.0"
  }
}
